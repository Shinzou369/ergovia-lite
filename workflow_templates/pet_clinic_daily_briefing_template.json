    {
      "parameters": {
        "jsCode": "const events = $input.all().map((item) => item.json);\n\nlet briefingMessage = \"\";\n\nif (events.length === 0) {\n  briefingMessage = \"✅ **No appointments scheduled for today.**\\n\\n🎉 Great day to catch up on administrative tasks, deep cleaning, or staff training!\";\n} else {\n  const appointmentCount = events.length;\n  briefingMessage = `📋 **${appointmentCount} appointment${appointmentCount > 1 ? 's' : ''} scheduled for today:**\\n\\n`;\n  \n  briefingMessage += events\n    .sort((a, b) => new Date(a.start?.dateTime || a.start?.date) - new Date(b.start?.dateTime || b.start?.date))\n    .map((event, index) => {\n      const startTime = event.start?.dateTime || event.start?.date;\n      const endTime = event.end?.dateTime || event.end?.date;\n      const summary = event.summary || 'Appointment';\n      \n      let timeDisplay = '';\n      if (startTime.includes('T')) {\n        // Time-based event\n        const start = new Date(startTime).toLocaleTimeString('en-US', { \n          hour: 'numeric', \n          minute: '2-digit', \n          hour12: true,\n          timeZone: '{{TIMEZONE}}'\n        });\n        const end = new Date(endTime).toLocaleTimeString('en-US', { \n          hour: 'numeric', \n          minute: '2-digit', \n          hour12: true,\n          timeZone: '{{TIMEZONE}}'\n        });\n        timeDisplay = `${start} - ${end}`;\n      } else {\n        // All-day event\n        timeDisplay = 'All Day';\n      }\n      \n      let petInfo = '';\n      if (event.description) {\n        const petIdMatch = event.description.match(/Pet ID: (\\d+)/);\n        const petNameMatch = event.description.match(/Pet Name: ([^\\n]+)/);\n        const ownerMatch = event.description.match(/Owner: ([^\\n]+)/);\n        \n        if (petIdMatch || petNameMatch || ownerMatch) {\n          petInfo = ' - ';\n          if (petNameMatch) petInfo += `🐾 ${petNameMatch[1]}`;\n          if (ownerMatch) petInfo += ` (Owner: ${ownerMatch[1]})`;\n          if (petIdMatch) petInfo += ` [ID: ${petIdMatch[1]}]`;\n        }\n      }\n      \n      return `${index + 1}. **${timeDisplay}** - ${summary}${petInfo}`;\n    })\n    .join('\\n');\n    \n  briefingMessage += `\\n\\n💡 **Remember:**\\n• Check appointment notes for special requirements\\n• Ensure all necessary supplies are ready\\n• Review patient history before appointments`;\n}\n\nreturn { briefingMessage };"
      },
      "name": "Format Briefing",
