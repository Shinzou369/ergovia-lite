    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "{{FILTER_CONDITION_ID}}",
              "leftValue": "={{ $json.Date }}",
              "rightValue": "={{ $now.setZone('{{TIMEZONE}}').plus({ days: 1 }).toFormat('yyyy-MM-dd') }}",
              "operator": {
                "type": "string",
                "operation": "contains",
                "name": "filter.operator.contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Filter Tomorrow's Appointments",
      "type": "n8n-nodes-base.if",
