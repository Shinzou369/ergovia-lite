            "Time": "={{ new Date($json.body.payload.event.start_time).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: '{{TIMEZONE}}' }) }}",
            "Customer Name": "={{ $json.body.payload.invitee.name }}",
            "Customer Email": "={{ $json.body.payload.invitee.email }}",
            "Customer Phone": "={{ $json.body.payload.questions_and_answers ? $json.body.payload.questions_and_answers.find(q => q.question.includes('phone') || q.question.includes('Phone'))?.answer : 'Not provided' }}",
            "Service": "={{ $json.body.payload.event_type.name }}",
            "Pet Name": "={{ $json.body.payload.questions_and_answers ? $json.body.payload.questions_and_answers.find(q => q.question.includes('pet') || q.question.includes('Pet'))?.answer : 'Not specified' }}",
            "Notes": "={{ $json.body.payload.questions_and_answers ? $json.body.payload.questions_and_answers.map(q => q.question + ': ' + q.answer).join(' | ') : 'No additional notes' }}",
            "Status": "Confirmed",
            "Created": "={{ $now.setZone('{{TIMEZONE}}').toFormat('yyyy-MM-dd HH:mm:ss') }}"
          }
        },
        "options": {}
