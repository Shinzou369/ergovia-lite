      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "{{GOOGLE_SHEETS_CREDENTIAL_ID}}",
          "name": "{{CLINIC_NAME}} Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "from": "{{BUSINESS_PHONE_NUMBER}}",
        "to": "={{ $json.body.payload.invitee.email.includes('@') ? $json.body.payload.questions_and_answers?.find(q => q.question.includes('phone') || q.question.includes('Phone'))?.answer || 'Phone not provided' : $json.body.payload.invitee.email }}",
        "message": "🎉 **{{CLINIC_NAME}} - Appointment Confirmed!**\n\n📅 **Date & Time:** {{ new Date($json.body.payload.event.start_time).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true, timeZone: '{{TIMEZONE}}' }) }}\n\n🏥 **Service:** {{ $json.body.payload.event_type.name }}\n📍 **Location:** {{CLINIC_ADDRESS}}\n\n⚠️ **Important:** Please note our {{CANCELLATION_POLICY}} cancellation policy.\n\n📞 **Questions?** Call us at {{BUSINESS_PHONE_NUMBER}}\n💌 **Email:** {{BUSINESS_EMAIL}}\n\nWe look forward to seeing you and your pet! 🐾",
        "options": {}
