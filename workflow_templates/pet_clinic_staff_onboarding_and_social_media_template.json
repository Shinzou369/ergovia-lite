    {
      "parameters": {
        "promptType": "define",
        "text": "Generate a helpful, engaging pet care tip for social media. The tip should be:\n- Educational and practical for pet owners\n- Safe and veterinarian-approved advice\n- Suitable for all types of pets (dogs, cats, birds, etc.) or specify the pet type\n- Written in a friendly, approachable tone\n- Include a call-to-action encouraging engagement\n- Be concise enough for social media (under 280 characters for the main tip)\n\nFormat your response as JSON with the following structure:\n{\n  \"tip\": \"The main tip text\",\n  \"hashtags\": [\"#PetCare\", \"#VetTips\", \"#HealthyPets\"],\n  \"callToAction\": \"Engagement question or prompt\",\n  \"petType\": \"General, Dogs, Cats, etc.\"\n}",
        "options": {
          "systemMessage": "You are a licensed veterinarian creating educational social media content for {{CLINIC_NAME}}. Focus on preventive care, general wellness, and safe practices. Avoid medical diagnosis or treatment advice that requires professional consultation. Include the clinic's specialties: {{SERVICES_OFFERED}}"
        }
      },
      "name": "Generate Pet Tip with AI",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        100,
        860
      ],
      "id": "93c4b3fe-bbfa-4a07-b97b-3d7ed96a06b0"
    },
    {
      "parameters": {
        "options": {
          "maxTokens": 500,
          "temperature": 0.7
        }
      },
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        180,
        1080
      ],
      "id": "ad155e74-232a-4cf5-aab6-27eecc112fe9",
      "credentials": {
        "openAiApi": {
          "id": "{{OPENAI_CREDENTIAL_ID}}",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output;\nlet petTipData;\n\ntry {\n  // Try to parse the AI response as JSON\n  petTipData = JSON.parse(aiOutput);\n} catch (error) {\n  // Fallback if AI doesn't return valid JSON\n  petTipData = {\n    tip: aiOutput,\n    hashtags: [\"#PetCare\", \"#VetTips\", \"#HealthyPets\", \"#{{CLINIC_NAME}}\"],\n    callToAction: \"What's your favorite pet care tip? Share below!\",\n    petType: \"General\"\n  };\n}\n\n// Ensure hashtags is an array\nif (!Array.isArray(petTipData.hashtags)) {\n  petTipData.hashtags = [\"#PetCare\", \"#VetTips\", \"#HealthyPets\", \"#{{CLINIC_NAME}}\"];\n}\n\n// Create the social media post\nconst socialMediaPost = `🐾 Pet Tip Tuesday from {{CLINIC_NAME}}! 🐾\\n\\n${petTipData.tip}\\n\\n${petTipData.callToAction}\\n\\n${petTipData.hashtags.join(' ')} #PetTipTuesday #VeterinaryAdvice #{{BUSINESS_CATEGORY}}\\n\\n📍 {{CLINIC_ADDRESS}}\\n📞 {{BUSINESS_PHONE}}\\n🌐 {{BUSINESS_WEBSITE}}`;\n\nreturn [{\n  json: {\n    postContent: socialMediaPost,\n    tip: petTipData.tip,\n    hashtags: petTipData.hashtags,\n    callToAction: petTipData.callToAction,\n    petType: petTipData.petType,\n    timestamp: new Date().toISOString(),\n    clinicName: '{{CLINIC_NAME}}'\n  }\n}];"
      },
      "name": "Format Social Media Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        860
      ],
      "id": "e0b4153a-000d-4de8-b3bc-cbf5aac6466b"
    },
