      "parameters": {
        "subject": "Checking In - {{CLINIC_NAME}}",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body { font-family: Arial, sans-serif; color: #333; }\n        .header { background-color: {{BUSINESS_COLOR}}; color: white; padding: 20px; text-align: center; }\n        .content { padding: 20px; }\n        .feedback-section { background-color: #e8f5e8; padding: 15px; margin: 10px 0; border-radius: 5px; }\n        .footer { background-color: #f8f9fa; padding: 15px; text-align: center; font-size: 12px; color: #666; }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>How are you settling in?</h1>\n    </div>\n    <div class=\"content\">\n        <p>Hi {{ $json.staffName }},</p>\n        <p>It's been 10 days since you joined our {{CLINIC_NAME}} family! We hope you're settling in well and feeling comfortable with your new role.</p>\n        \n        <div class=\"feedback-section\">\n            <h3>We'd love to hear from you:</h3>\n            <ul>\n                <li>How has your experience been so far?</li>\n                <li>Do you have any questions about our procedures?</li>\n                <li>Is there any additional support you need?</li>\n                <li>Any feedback on the training materials?</li>\n            </ul>\n        </div>\n        \n        <p><strong>Quick Reminders:</strong></p>\n        <ul>\n            <li>Complete any remaining training modules</li>\n            <li>Review our {{CANCELLATION_POLICY}} policy</li>\n            <li>Familiarize yourself with our emergency procedures</li>\n        </ul>\n        \n        <p><strong>Need Help?</strong></p>\n        <p>Don't hesitate to reach out:</p>\n        <ul>\n            <li>{{MANAGER_NAME}} - General questions: {{SUPPORT_EMAIL}}</li>\n            <li>{{VETERINARIAN_NAME}} - Medical procedures</li>\n            <li>Emergency contact: {{EMERGENCY_CONTACT}}</li>\n        </ul>\n        \n        <p>We're here to support your success. Thank you for being part of our mission to provide excellent care for pets and their families!</p>\n        \n        <p>Warm regards,<br>The {{CLINIC_NAME}} Team</p>\n    </div>\n    <div class=\"footer\">\n        <p>{{CLINIC_NAME}} | {{CLINIC_ADDRESS}} | {{BUSINESS_PHONE}}</p>\n        <p>Visit us: {{BUSINESS_WEBSITE}}</p>\n    </div>\n</body>\n</html>",
