      "parameters": {
        "subject": "Your Training Resources - {{CLINIC_NAME}}",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body { font-family: Arial, sans-serif; color: #333; }\n        .header { background-color: {{BUSINESS_COLOR}}; color: white; padding: 20px; text-align: center; }\n        .content { padding: 20px; }\n        .training-section { background-color: #f8f9fa; padding: 15px; margin: 10px 0; border-left: 4px solid {{BUSINESS_COLOR}}; }\n        .footer { background-color: #f8f9fa; padding: 15px; text-align: center; font-size: 12px; color: #666; }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>Training Resources Ready!</h1>\n    </div>\n    <div class=\"content\">\n        <p>Hi {{ $json.staffName }},</p>\n        <p>Your training materials are now available! Here's what you need to complete:</p>\n        \n        <div class=\"training-section\">\n            <h3>🏥 Essential Training Modules:</h3>\n            <ul>\n                <li><strong>Animal Safety Protocols</strong> - Required completion by end of week 1</li>\n                <li><strong>Customer Service Excellence</strong> - Interactive module</li>\n                <li><strong>Medical Record Management</strong> - Hands-on training</li>\n                <li><strong>Emergency Procedures</strong> - Critical safety information</li>\n            </ul>\n        </div>\n        \n        <div class=\"training-section\">\n            <h3>📋 Services We Offer:</h3>\n            <p>{{SERVICES_OFFERED}}</p>\n        </div>\n        \n        <p><strong>Access Your Training:</strong></p>\n        <ul>\n            <li><a href=\"{{BOOKING_URL}}\">Training Portal</a></li>\n            <li><a href=\"{{BUSINESS_WEBSITE}}/training\">Online Modules</a></li>\n        </ul>\n        \n        <p>Remember: Our clinic hours are {{CLINIC_HOURS}}. For emergencies, contact {{EMERGENCY_CONTACT}}.</p>\n        \n        <p>Questions? Contact {{MANAGER_NAME}} at {{SUPPORT_EMAIL}}</p>\n        \n        <p>Best regards,<br>{{VETERINARIAN_NAME}}<br>{{CLINIC_NAME}}</p>\n    </div>\n    <div class=\"footer\">\n        <p>{{CLINIC_NAME}} | {{CLINIC_ADDRESS}} | {{BUSINESS_PHONE}}</p>\n    </div>\n</body>\n</html>",
