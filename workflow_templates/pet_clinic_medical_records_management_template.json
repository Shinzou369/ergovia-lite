    {
      "parameters": {
        "jsCode": "const visitData = $json;\nconst recordId = `MR-${Date.now()}`;\nconst visitDate = new Date().toISOString().split('T')[0];\n\n// Extract and format medical record data\nconst medicalRecord = {\n  recordId: recordId,\n  appointmentId: visitData.appointmentId || visitData.id || 'N/A',\n  petId: visitData['Pet ID'] || visitData.petId || `PET-${Date.now()}`,\n  petName: visitData['Pet Name'] || 'N/A',\n  petBreed: visitData['Pet Breed'] || 'N/A',\n  petAge: visitData['Pet Age'] || 'N/A',\n  clientId: visitData['Customer ID'] || visitData.clientId || `CLIENT-${Date.now()}`,\n  clientName: visitData['Customer Name'] || 'N/A',\n  clientEmail: visitData['Customer Email'] || 'N/A',\n  clientPhone: visitData['Customer Phone'] || 'N/A',\n  visitDate: visitDate,\n  visitTime: visitData['Time'] || new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }),\n  serviceType: visitData['Service'] || 'General Consultation',\n  veterinarian: visitData['Assigned Veterinarian'] || '{{DEFAULT_VETERINARIAN}}',\n  chiefComplaint: visitData['Chief Complaint'] || visitData['Notes'] || 'Routine check-up',\n  clinicalFindings: visitData['Clinical Findings'] || 'To be updated by veterinarian',\n  diagnosis: visitData['Diagnosis'] || 'Pending clinical assessment',\n  treatment: visitData['Treatment'] || 'As per clinical recommendation',\n  medications: visitData['Medications'] || 'None prescribed',\n  followUpNotes: visitData['Follow-up Notes'] || 'Routine follow-up as needed',\n  vitalSigns: {\n    weight: visitData['Weight'] || 'Not recorded',\n    temperature: visitData['Temperature'] || 'Not recorded',\n    heartRate: visitData['Heart Rate'] || 'Not recorded',\n    respiratoryRate: visitData['Respiratory Rate'] || 'Not recorded'\n  },\n  visitStatus: 'Complete',\n  recordStatus: visitData['Staff Notes'] === 'Complete' ? 'Finalized' : 'Pending Documentation',\n  createdBy: visitData['Staff ID'] || 'System',\n  createdAt: new Date().toISOString(),\n  clinicLocation: '{{CLINIC_NAME}}',\n  invoiceAmount: visitData['Invoice Amount'] || '0.00',\n  insuranceInfo: visitData['Insurance'] || 'None',\n  emergencyContact: visitData['Emergency Contact'] || visitData['Customer Phone'],\n  specialInstructions: visitData['Special Instructions'] || 'None'\n};\n\nreturn {\n  json: medicalRecord\n};"
      },
      "name": "Format Medical Record Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
