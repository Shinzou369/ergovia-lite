    {
      "parameters": {
        "fromEmail": "{{BUSINESS_EMAIL}}",
        "toEmail": "{{ $json['Assigned Veterinarian Email'] || '{{ADMIN_EMAIL}}' }}",
        "subject": "⚠️ Reminder: Complete Visit Notes - {{ $json['Pet Name'] }} ({{ $json['Customer Name'] }})",
        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { text-align: center; color: #{{CLINIC_COLOR}}; border-bottom: 2px solid #{{CLINIC_COLOR}}; padding-bottom: 20px; }\n    .reminder { background: #fff3cd; border: 1px solid #ffeaa7; padding: 20px; border-radius: 10px; margin: 20px 0; }\n    .details { margin: 20px 0; }\n    .urgent { color: #d63031; font-weight: bold; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>{{CLINIC_NAME}}</h1>\n    <p>Staff Reminder - Complete Visit Notes</p>\n  </div>\n  \n  <div class=\"reminder\">\n    <h2>⚠️ Action Required: Complete Visit Notes</h2>\n    <p class=\"urgent\">Please complete the visit notes for the following patient:</p>\n  </div>\n  \n  <div class=\"details\">\n    <h3>Visit Details:</h3>\n    <p><strong>Pet:</strong> {{ $json['Pet Name'] }}</p>\n    <p><strong>Owner:</strong> {{ $json['Customer Name'] }}</p>\n    <p><strong>Visit Date:</strong> {{ $json['Date'] }}</p>\n    <p><strong>Service:</strong> {{ $json['Service'] }}</p>\n    <p><strong>Appointment ID:</strong> {{ $json.appointmentId || $json.id }}</p>\n  </div>\n  \n  <div style=\"margin-top: 30px; padding: 15px; background: #e8f4fd; border-radius: 5px;\">\n    <p><strong>What's Needed:</strong></p>\n    <p>• Complete clinical observations</p>\n    <p>• Record diagnosis and treatment details</p>\n    <p>• Update medical history notes</p>\n    <p>• Mark visit as documentation complete</p>\n  </div>\n  \n  <div style=\"text-align: center; margin-top: 20px;\">\n    <p><strong>Access Medical Records:</strong> {{MEDICAL_RECORDS_SYSTEM_URL}}</p>\n    <p>Questions? Contact {{ADMIN_EMAIL}} or call {{BUSINESS_PHONE_NUMBER}}</p>\n  </div>\n</body>\n</html>",
        "options": {
          "replyTo": "{{BUSINESS_EMAIL}}"
        }
      },
      "name": "Send Staff Notes Reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1020,
        300
