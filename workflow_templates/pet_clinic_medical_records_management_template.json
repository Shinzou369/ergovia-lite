        "fromEmail": "{{BUSINESS_EMAIL}}",
        "toEmail": "={{ $json.clientEmail }}",
        "subject": "📋 Medical Records Updated - {{ $json.petName }} - {{CLINIC_NAME}}",
        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { text-align: center; color: #{{CLINIC_COLOR}}; border-bottom: 2px solid #{{CLINIC_COLOR}}; padding-bottom: 20px; }\n    .update { background: #e8f5e8; padding: 20px; border-radius: 10px; margin: 20px 0; }\n    .details { margin: 20px 0; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>{{CLINIC_NAME}}</h1>\n    <p>Medical Records Update</p>\n  </div>\n  \n  <div class=\"update\">\n    <h2>📋 Medical Records Updated Successfully</h2>\n    <p>Hello {{ $json.clientName }},</p>\n    <p>We've updated {{ $json.petName }}'s medical records following their recent visit.</p>\n  </div>\n  \n  <div class=\"details\">\n    <h3>Visit Summary:</h3>\n    <p><strong>Pet:</strong> {{ $json.petName }}</p>\n    <p><strong>Visit Date:</strong> {{ $json.visitDate }}</p>\n    <p><strong>Service:</strong> {{ $json.serviceType }}</p>\n    <p><strong>Veterinarian:</strong> {{ $json.veterinarian }}</p>\n    <p><strong>Record ID:</strong> {{ $json.recordId }}</p>\n  </div>\n  \n  <div style=\"margin-top: 30px; padding: 15px; background: #f0f8ff; border-radius: 5px;\">\n    <p><strong>What's Next:</strong></p>\n    <p>• Medical records are securely stored in our system</p>\n    <p>• Follow-up care recommendations will be sent if needed</p>\n    <p>• You can request copies of records anytime</p>\n  </div>\n  \n  <div style=\"text-align: center; margin-top: 20px;\">\n    <p><strong>Questions?</strong> Contact us at {{BUSINESS_PHONE_NUMBER}} or {{BUSINESS_EMAIL}}</p>\n    <p style=\"color: #666;\">Thank you for trusting us with {{ $json.petName }}'s care! 🐾</p>\n  </div>\n</body>\n</html>",
        "options": {
          "ccEmail": "{{ADMIN_EMAIL}}",
          "replyTo": "{{BUSINESS_EMAIL}}"
        }
      },
