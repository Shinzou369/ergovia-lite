    },
    {
      "parameters": {
        "jsCode": "// Extract contact_id from property configuration based on assigned_to role\nconst taskData = $input.first().json;\nconst configData = $('Query Property Configuration').first().json;\n\n// Get the assigned_to role from the task data\nconst assignedToRole = taskData.assigned_to;\n\n// Extract the contact_id from the configuration\nlet contactId = null;\n\nif (assignedToRole && configData[assignedToRole]) {\n  contactId = configData[assignedToRole];\n}\n\n// Return the contact_id along with the original task data\nreturn {\n  json: {\n    ...taskData,\n    contact_id: contactId\n  }\n};"
      },
      "id": "5fe946f8-02cc-4a40-ae90-18cb89c255fc",
      "name": "Extract Contact ID from Property Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1344,
        640
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract contact_id from system configuration based on assigned_to role\nconst taskData = $input.first().json;\nconst systemConfig = $('Query System Configuration').all();\n\n// Get the assigned_to role from the task data\nconst assignedToRole = taskData.assigned_to;\n\n// Find the matching contact in system configuration\nlet contactId = null;\n\nfor (const config of systemConfig) {\n  if (config.json.role === assignedToRole) {\n    contactId = config.json.contact_id;\n    break;\n  }\n}\n\n// Return the contact_id along with the original task data\nreturn [{\n  json: {\n    ...taskData,\n    contact_id: contactId\n  }\n}];"
      },
