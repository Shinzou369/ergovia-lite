    {
      "parameters": {
        "jsCode": "// Generate task ID using timestamp\nconst taskId = `TASK-${Date.now()}`;\n\n// Get current timestamp\nconst createdDate = new Date().toISOString();\n\n// Get all webhook data from the first item\nconst webhookData = $input.first().json;\n\n// Return new item with generated fields and all webhook data\nreturn [\n  {\n    json: {\n      task_id: taskId,\n      status: 'pending',\n      created_date: createdDate,\n      ...webhookData\n    }\n  }\n];"
      },
