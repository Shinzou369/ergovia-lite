    {
      "parameters": {
        "jsCode": "// Get webhook data from the first item\nconst webhookData = $input.first().json;\n\n// Generate booking ID using timestamp\nconst timestamp = Date.now();\nconst booking_id = `BK${timestamp}`;\n\n// Parse check-in and check-out dates\nconst checkInDate = new Date(webhookData.check_in);\nconst checkOutDate = new Date(webhookData.check_out);\n\n// Calculate number of nights\nconst timeDiff = checkOutDate.getTime() - checkInDate.getTime();\nconst nights = Math.ceil(timeDiff / (1000 * 3600 * 24));\n\n// Get current timestamp for created_date\nconst created_date = new Date().toISOString();\n\n// Return all webhook data plus calculated fields\nreturn [{\n  json: {\n    ...webhookData,\n    booking_id: booking_id,\n    nights: nights,\n    booking_status: 'confirmed',\n    payment_confirmed: true,\n    created_date: created_date\n  }\n}];"
      },
