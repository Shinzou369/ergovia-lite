    {
      "parameters": {
        "jsCode": "// Format Side-by-Side Deal Comparison for Contact\nconst deals = $input.all();\nconst property = deals[0].json.property_name;\nconst propertyConfig = deals[0].json.property_config;\n\n// Get designated contact\nconst contactId = propertyConfig.pricing_decision_contact || propertyConfig.booking_approval_contact;\nconst contactMethod = (propertyConfig.pricing_decision_contact_method || propertyConfig.booking_approval_contact_method || 'telegram').toLowerCase();\n\n// Build message header\nlet message = `\u26a0\ufe0f *BOOKING CONFLICT: ${property}*\\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n\\n`;\nmessage += `Multiple guests want the same dates.\\n\\n`;\n\n// Add party policy reminder if applicable\nconst hasHighRisk = deals.some(d => d.json.party_risk_level === 'high');\nconst hasMediumRisk = deals.some(d => d.json.party_risk_level === 'medium');\n\nif (hasHighRisk && propertyConfig.party_policy === 'recommend_decline') {\n  message += `\u26a0\ufe0f *PARTY POLICY:* Recommend Decline\\n`;\n  message += `Your property policy is set to decline party bookings.\\n\\n`;\n} else if (hasHighRisk || hasMediumRisk) {\n  message += `\u26a0\ufe0f *NOTICE:* Party risk detected in one or more deals\\n\\n`;\n}\n\nmessage += `Choose the best option:\\n\\n`;\n\n// Format each deal option\ndeals.forEach((deal, i) => {\n  const d = deal.json;\n  \n  message += `\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n`;\n  message += `*OPTION ${i + 1}*`;\n  \n  if (i === 0) {\n    message += ` \u2b50 *RECOMMENDED*`;\n  }\n  \n  message += `\\n`;\n  \n  // Add party warning if present\n  if (d.party_warning) {\n    message += `${d.party_warning}\\n`;\n  }\n  \n  message += `\\n`;\n  message += `\ud83d\udc64 Guest: ${d.client_name || 'Unknown'}\\n`;\n  message += `\ud83d\udcc5 ${d.check_in_date} \u2192 ${d.check_out_date}\\n`;\n  message += `\ud83c\udf19 ${d.nights} nights @ $${d.daily_rate}/night\\n`;\n  message += `\ud83d\udcb0 Total Value: $${d.total_value}\\n`;\n  message += `\u23f0 Booked ${d.lead_time} days in advance\\n`;\n  message += `\ud83c\udfaf Priority Score: ${d.priority_score}\\n`;\n  \n  // Additional info\n  if (d.guest_count) {\n    message += `\ud83d\udc65 Guests: ${d.guest_count}\\n`;\n  }\n  \n  if (d.booking_purpose) {\n    message += `\ud83d\udcdd Purpose: ${d.booking_purpose}\\n`;\n  }\n  \n  if (d.special_requests) {\n    message += `\ud83d\udccb Requests: ${d.special_requests}\\n`;\n  }\n  \n  if (d.previous_bookings && parseInt(d.previous_bookings) > 0) {\n    message += `\u2b50 Returning Guest (${d.previous_bookings} previous stays)\\n`;\n  }\n  \n  message += `\\n`;\n});\n\nmessage += `\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n`;\nmessage += `\u23f1\ufe0f Please decide within 48 hours`;\n\n// Create inline keyboard\nconst keyboard = {\n  inline_keyboard: [\n    ...deals.map((d, i) => [{\n      text: `\u2713 Choose Option ${i + 1}`,\n      callback_data: `choose_${d.json.deal_id}`\n    }]),\n    [{\n      text: '\u274c Decline All',\n      callback_data: 'decline_all'\n    }],\n    [{\n      text: '\u2139\ufe0f Request More Info',\n      callback_data: 'more_info'\n    }]\n  ]\n};\n\nreturn [{\n  json: {\n    message: message,\n    keyboard: keyboard,\n    deals: deals.map(d => d.json),\n    contact_id: contactId,\n    contact_method: contactMethod,\n    property_id: deals[0].json.property_id,\n    property_name: property\n  }\n}];"
      },
