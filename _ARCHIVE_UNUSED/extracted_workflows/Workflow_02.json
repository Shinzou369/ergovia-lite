    {
      "parameters": {
        "jsCode": "// Enhanced Priority Score Calculator with Party Risk Check\nconst deals = $('Get Conflicting Deals').all();\nconst propertyConfig = $('Get Property Configuration').first().json;\n\nconst scored = deals.map(deal => {\n  const d = deal.json;\n  \n  // Calculate nights and daily rate\n  const checkIn = new Date(d.check_in_date);\n  const checkOut = new Date(d.check_out_date);\n  const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));\n  const totalValue = parseFloat(d.total_value) || 0;\n  const dailyRate = nights > 0 ? totalValue / nights : 0;\n  \n  // Calculate lead time\n  const now = new Date();\n  const leadTime = Math.ceil((checkIn - now) / (1000 * 60 * 60 * 24));\n  \n  // Initialize priority score\n  let score = 0;\n  \n  // PRICING FACTORS\n  score += dailyRate / 10;  // Higher daily rate = higher priority\n  score += totalValue / 100; // Higher total value = higher priority\n  \n  // LENGTH OF STAY BONUSES\n  if (nights >= 7) score += 10;   // Weekly stay bonus\n  if (nights >= 14) score += 20;  // Bi-weekly stay bonus\n  if (nights >= 28) score += 30;  // Monthly stay bonus\n  \n  // LEAD TIME FACTORS\n  if (leadTime < 3) score -= 15;    // Last-minute bookings penalized\n  if (leadTime >= 7) score += 3;    // Week advance bonus\n  if (leadTime >= 14) score += 5;   // Two weeks advance bonus\n  if (leadTime >= 30) score += 8;   // Month advance bonus\n  \n  // PARTY RISK ASSESSMENT\n  let partyWarning = '';\n  let partyRiskLevel = 'none';\n  \n  // Check party risk from deal data\n  const partyRisk = (d.party_risk || '').toLowerCase();\n  const guestCount = parseInt(d.guest_count) || 0;\n  const maxGuests = parseInt(propertyConfig.max_guests) || 999;\n  const purpose = (d.booking_purpose || '').toLowerCase();\n  const partyPolicy = (propertyConfig.party_policy || '').toLowerCase();\n  \n  // HIGH PARTY RISK DETECTION\n  if (partyRisk === 'high' || \n      purpose.includes('party') || \n      purpose.includes('event') || \n      purpose.includes('celebration') ||\n      guestCount > maxGuests) {\n    \n    partyRiskLevel = 'high';\n    score -= 20; // Significant penalty\n    \n    if (partyPolicy === 'recommend_decline' || partyPolicy === 'decline') {\n      partyWarning = '\u26a0\ufe0f HIGH PARTY RISK - RECOMMEND DECLINE';\n      score -= 30; // Additional penalty for decline policy\n    } else {\n      partyWarning = '\u26a0\ufe0f HIGH PARTY RISK - USE CAUTION';\n    }\n  }\n  // MEDIUM PARTY RISK DETECTION\n  else if (partyRisk === 'medium' || \n           guestCount >= (maxGuests * 0.8) ||\n           purpose.includes('group') ||\n           purpose.includes('birthday')) {\n    \n    partyRiskLevel = 'medium';\n    score -= 10; // Moderate penalty\n    partyWarning = '\u26a0\ufe0f MEDIUM PARTY RISK - VERIFY GUEST';\n  }\n  \n  // GUEST HISTORY BONUS (if available)\n  if (d.previous_bookings) {\n    const prevBookings = parseInt(d.previous_bookings) || 0;\n    if (prevBookings > 0) score += prevBookings * 5; // Returning guest bonus\n  }\n  \n  // SPECIAL CIRCUMSTANCES\n  if (d.is_corporate === true || d.is_corporate === 'true') {\n    score += 15; // Corporate bookings prioritized\n  }\n  \n  if (d.has_damage_insurance === true || d.has_damage_insurance === 'true') {\n    score += 5; // Insurance bonus\n  }\n  \n  return {\n    ...d,\n    nights: nights,\n    daily_rate: Math.round(dailyRate * 100) / 100,\n    lead_time: leadTime,\n    priority_score: Math.round(score * 10) / 10,\n    party_warning: partyWarning,\n    party_risk_level: partyRiskLevel,\n    property_config: propertyConfig\n  };\n});\n\n// Sort by priority score (highest to lowest)\nscored.sort((a, b) => b.priority_score - a.priority_score);\n\nreturn scored.map(s => ({json: s}));"
      },
