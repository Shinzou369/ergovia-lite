      "parameters": {
        "jsCode": "// Convert keyboard to WhatsApp format (max 3 buttons)\nconst data = $input.first().json;\n\nconst buttons = data.keyboard.inline_keyboard\n  .slice(0, 3)\n  .map(row => ({\n    type: 'reply',\n    reply: {\n      id: row[0].callback_data,\n      title: row[0].text.substring(0, 20)\n    }\n  }));\n\nreturn [{\n  json: {\n    to: data.contact_id,\n    body: data.message,\n    buttons: buttons,\n    deals: data.deals\n  }\n}];"
      },
