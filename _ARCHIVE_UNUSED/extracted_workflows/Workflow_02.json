    },
    {
      "parameters": {
        "jsCode": "// Confirmation to Contact\nconst decisionData = $('Process Contact Decision').first().json;\nconst winningDeal = decisionData.chosen_deal;\nconst contactData = $('Contact Message Formatter').first().json;\n\nif (!winningDeal) {\n  return [{\n    json: {\n      message: 'Error: No deal selected',\n      contact_method: contactData.contact_method,\n      contact_id: contactData.contact_id\n    }\n  }];\n}\n\nconst message = `\u2705 *DECISION RECORDED*\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\nApproved: ${winningDeal.client_name}\nProperty: ${winningDeal.property_name}\nDates: ${winningDeal.check_in_date} \u2192 ${winningDeal.check_out_date}\nValue: $${winningDeal.total_value}\n\n\u2705 Winner notified\n\u274c Other guests declined\n\ud83d\udce7 Confirmation email sent\n\n\u26a0\ufe0f *REMINDER:* Block these dates on:\n\u2022 Airbnb\n\u2022 Vrbo\n\u2022 Booking.com\n\u2022 Other listing platforms`;\n\nconst keyboard = {\n  inline_keyboard: [\n    [{text: '\ud83d\udcb3 Send Payment Instructions', callback_data: `payment_${winningDeal.deal_id}`}],\n    [{text: '\ud83d\udccb View Deal', callback_data: `view_${winningDeal.deal_id}`}],\n    [{text: '\ud83c\udfe1 Dashboard', callback_data: 'dashboard'}]\n  ]\n};\n\nreturn [{\n  json: {\n    message: message,\n    keyboard: keyboard,\n    contact_method: contactData.contact_method,\n    contact_id: contactData.contact_id\n  }\n}];"
      },
