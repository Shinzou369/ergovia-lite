    {
      "parameters": {
        "jsCode": "// Email to Winning Guest\nconst winningDeal = $('Process Contact Decision').first().json.chosen_deal;\n\nif (!winningDeal) {\n  return [];\n}\n\nconst subject = `Great News - Your Booking at ${winningDeal.property_name} is Approved!`;\n\nconst message = `Dear ${winningDeal.client_name},\n\nCongratulations! Your booking request has been approved.\n\nProperty: ${winningDeal.property_name}\nCheck-in: ${winningDeal.check_in_date}\nCheck-out: ${winningDeal.check_out_date}\nNights: ${winningDeal.nights}\nTotal: $${winningDeal.total_value}\n\nWe'll send payment instructions shortly. We're excited to host you!\n\nBest regards,\nProperty Management Team`;\n\nreturn [{\n  json: {\n    to: winningDeal.client_email,\n    subject: subject,\n    body: message\n  }\n}];"
      },
      "id": "540f44df-ca47-401a-909e-1c0c01d3862c",
