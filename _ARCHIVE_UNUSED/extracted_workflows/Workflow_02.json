    {
      "parameters": {
        "jsCode": "// Send Decline Messages to Losing Guests\nconst deal = $json;\nconst channelType = (deal.channel_type || 'sms').toLowerCase();\n\nconst message = `Dear ${deal.client_name || 'Guest'},\n\nThank you for your interest in ${deal.property_name}.\n\nUnfortunately, the property has been booked by another guest for ${deal.check_in_date} to ${deal.check_out_date}.\n\nWe'd love to help you find alternative dates or check our other properties. Please let us know if you'd like assistance.\n\nBest regards,\nProperty Management Team`;\n\nreturn [{\n  json: {\n    platform: channelType,\n    to: deal.client_phone || deal.client_email,\n    chat_id: deal.telegram_chat_id,\n    message: message,\n    client_name: deal.client_name\n  }\n}];"
      },
