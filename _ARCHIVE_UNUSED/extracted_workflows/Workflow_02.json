    {
      "parameters": {
        "jsCode": "// Process Contact Decision from callback or SMS\nconst items = $input.all();\nconst responseData = items[0].json;\n\n// Extract callback data and deals\nlet callbackData = '';\nlet deals = [];\n\n// Parse from Telegram callback\nif (responseData.callback_query) {\n  callbackData = responseData.callback_query.data;\n  deals = responseData.deals || [];\n}\n// Parse from WhatsApp\nelse if (responseData.message && responseData.message.text) {\n  callbackData = responseData.message.text;\n  deals = responseData.deals || [];\n}\n// Parse from SMS (Twilio)\nelse if (responseData.Body) {\n  callbackData = responseData.Body.trim();\n  deals = responseData.deals || [];\n}\n// Parse from direct data\nelse if (responseData.data) {\n  callbackData = responseData.data;\n  deals = responseData.deals || [];\n}\n\n// If deals not in response, get from previous node\nif (deals.length === 0) {\n  const contactMsg = $('Contact Message Formatter').first().json;\n  deals = contactMsg.deals || [];\n}\n\nlet chosenDealId = null;\nlet action = 'unknown';\nlet chosenDealIndex = -1;\n\n// Parse decision\nif (callbackData.startsWith('choose_')) {\n  chosenDealId = callbackData.replace('choose_', '');\n  action = 'approve';\n  chosenDealIndex = deals.findIndex(d => d.deal_id === chosenDealId);\n} \nelse if (callbackData === 'decline_all') {\n  action = 'decline_all';\n} \nelse if (callbackData === 'more_info') {\n  action = 'request_more_info';\n}\n// SMS numeric response\nelse if (callbackData.match(/^[1-9]$/)) {\n  chosenDealIndex = parseInt(callbackData) - 1;\n  if (deals[chosenDealIndex]) {\n    chosenDealId = deals[chosenDealIndex].deal_id;\n    action = 'approve';\n  }\n}\n// SMS text response\nelse if (callbackData.toLowerCase().includes('decline')) {\n  action = 'decline_all';\n}\n\nconst chosenDeal = deals.find(d => d.deal_id === chosenDealId);\nconst rejectedDeals = deals.filter(d => d.deal_id !== chosenDealId);\n\nreturn [{\n  json: {\n    chosen_deal_id: chosenDealId,\n    chosen_deal: chosenDeal,\n    rejected_deals: rejectedDeals,\n    action: action,\n    all_deals: deals,\n    decision_timestamp: new Date().toISO()\n  }\n}];"
      },
