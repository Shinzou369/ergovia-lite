    {
      "parameters": {
        "jsCode": "// Get all processed messages from the loop\\nconst processedMessages = $input.all();\\n\\n// Get configuration from Workflow Configuration node\\nconst config = $('Workflow Configuration').first().json;\\nconst contactPlatform = config.booking_contact_platform || 'Unknown';\\nconst contactId = config.booking_contact_id || 'Unknown';\\n\\n// Initialize counters\\nlet totalMessages = processedMessages.length;\\nlet smsCount = 0;\\nlet whatsappCount = 0;\\nlet telegramCount = 0;\\n\\n// Count messages by channel\\nfor (const message of processedMessages) {\\n  const channel = message.json.channel_type || message.json.channel;\\n  \\n  if (channel === 'SMS') {\\n    smsCount++;\\n  } else if (channel === 'WhatsApp') {\\n    whatsappCount++;\\n  } else if (channel === 'Telegram') {\\n    telegramCount++;\\n  }\\n}\\n\\n// Build channel breakdown string\\nlet channelBreakdown = [];\\nif (smsCount > 0) channelBreakdown.push(`${smsCount} SMS`);\\nif (whatsappCount > 0) channelBreakdown.push(`${whatsappCount} WhatsApp`);\\nif (telegramCount > 0) channelBreakdown.push(`${telegramCount} Telegram`);\\n\\nconst channelSummary = channelBreakdown.join(', ');\\n\\n// Create summary message\\nconst summaryMessage = `\u2713 Scheduled message batch complete - ${totalMessages} messages delivered successfully via ${channelSummary}`;\\n\\n// Return summary data\\nreturn {\\n  json: {\\n    total_messages: totalMessages,\\n    sms_count: smsCount,\\n    whatsapp_count: whatsappCount,\\n    telegram_count: telegramCount,\\n    summary_message: summaryMessage,\\n    booking_contact_platform: contactPlatform,\\n    booking_contact_id: contactId,\\n    timestamp: new Date().toISOString()\\n  }\\n};"
      },
      "id": "1a1b8759-4582-40cb-8559-206db119efc4",
      "name": "Prepare Summary Data",
