    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get the message template from the current item\\nconst messageTemplate = $input.item.json.message_template;\\n\\n// Get booking data (from Query Bookings Sheet node)\\nconst bookingData = $('Query Bookings Sheet').item.json;\\n\\n// Get property data (from Query Properties Sheet node)\\nconst propertyData = $('Query Properties Sheet').item.json;\\n\\n// Replace all template variables with actual values\\nlet finalMessage = messageTemplate;\\n\\n// Replace booking-related variables\\nfinalMessage = finalMessage.replace(/\\\\[Guest Name\\\\]/g, bookingData.guest_name || '');\\nfinalMessage = finalMessage.replace(/\\\\[Check-in Date\\\\]/g, bookingData.checkin_date || '');\\nfinalMessage = finalMessage.replace(/\\\\[Check-out Date\\\\]/g, bookingData.checkout_date || '');\\nfinalMessage = finalMessage.replace(/\\\\[Check-in Time\\\\]/g, bookingData.checkin_time || '');\\nfinalMessage = finalMessage.replace(/\\\\[Check-out Time\\\\]/g, bookingData.checkout_time || '');\\n\\n// Replace property-related variables\\nfinalMessage = finalMessage.replace(/\\\\[Property Name\\\\]/g, propertyData.property_name || '');\\nfinalMessage = finalMessage.replace(/\\\\[Property Address\\\\]/g, propertyData.property_address || '');\\nfinalMessage = finalMessage.replace(/\\\\[Door Code\\\\]/g, propertyData.door_code || '');\\nfinalMessage = finalMessage.replace(/\\\\[Wifi Network\\\\]/g, propertyData.wifi_network || '');\\nfinalMessage = finalMessage.replace(/\\\\[Wifi Password\\\\]/g, propertyData.wifi_password || '');\\nfinalMessage = finalMessage.replace(/\\\\[Lockbox Location\\\\]/g, propertyData.lockbox_location || '');\\nfinalMessage = finalMessage.replace(/\\\\[Parking Instructions\\\\]/g, propertyData.parking_instructions || '');\\n\\n// Return the personalized message along with other data\\nreturn {\\n  ...($input.item.json),\\n  final_message: finalMessage\\n};"
      },
      "id": "b5f68907-7e59-4cf7-a87b-cfe548ccaa42",
      "name": "Replace Template Variables",
