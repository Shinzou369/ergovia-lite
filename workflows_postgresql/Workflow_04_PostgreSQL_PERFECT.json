    {
      "parameters": {
        "jsCode": "// Enhanced Action Parser with Validation\nconst input = $input.first().json;\n\n// Extract callback data from different possible sources\nconst callbackData = input.callback_query?.data || \n                     input.callback_data || \n                     input.data || \n                     '';\n\n// Parse action and task_id\nconst parts = callbackData.split('_');\nconst action = parts[0] || '';\nconst task_id = parts.slice(1).join('_') || '';\n\n// Extract user/contact information\nconst contact_id = input.callback_query?.from?.id || \n                   input.from?.id || \n                   $('Workflow Configuration').first().json.ownerId;\n\nconst contact_name = input.callback_query?.from?.first_name || \n                     input.from?.first_name || \n                     $('Workflow Configuration').first().json.ownerName;\n\n// Determine updates based on action\nlet updates = {};\nlet responseMessage = '';\nlet shouldNotifyManager = false;\n\nswitch(action) {\n  case 'complete':\n    updates = {\n      status: 'completed',\n      completed_date: new Date().toISOString(),\n      completed_by: contact_name\n    };\n    responseMessage = `\u2705 Task marked as complete!`;\n    shouldNotifyManager = false;\n    break;\n    \n  case 'snooze':\n    const newDue = new Date();\n    newDue.setHours(newDue.getHours() + 2);\n    updates = {\n      due_date: newDue.toISOString(),\n      status: 'snoozed',\n      snoozed_at: new Date().toISOString(),\n      snoozed_by: contact_name\n    };\n    responseMessage = `\u23f0 Task snoozed for 2 hours`;\n    shouldNotifyManager = false;\n    break;\n    \n  case 'delegate':\n    updates = {\n      status: 'delegated',\n      assigned_to: $('Workflow Configuration').first().json.managerName,\n      delegated_at: new Date().toISOString(),\n      delegated_by: contact_name\n    };\n    responseMessage = `\ud83d\udc64 Task delegated to manager`;\n    shouldNotifyManager = true;\n    break;\n    \n  case 'details':\n    // Fetch full task details\n    responseMessage = `\u2139\ufe0f Fetching task details...`;\n    break;\n    \n  case 'refresh_tasks':\n    responseMessage = `\ud83d\udd04 Refreshing task list...`;\n    break;\n    \n  case 'view_analytics':\n    responseMessage = `\ud83d\udcca Loading analytics...`;\n    break;\n    \n  case 'dashboard':\n    responseMessage = `\ud83c\udfe1 Opening dashboard...`;\n    break;\n    \n  case 'create_task':\n    responseMessage = `\u2795 Create new task...`;\n    break;\n    \n  default:\n    responseMessage = `\u2753 Unknown action: ${action}`;\n}\n\nreturn [{\n  json: {\n    task_id,\n    action,\n    updates,\n    contact_id,\n    contact_name,\n    channel_type: $('Workflow Configuration').first().json.ownerPlatform,\n    responseMessage,\n    shouldNotifyManager,\n    timestamp: new Date().toISOString(),\n    original_callback: callbackData\n  }\n}];"
      },
