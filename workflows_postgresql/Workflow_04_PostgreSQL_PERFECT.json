      "id": "7ade14c5-627b-4e7b-a8bd-6173b84c82a3",
      "name": "Query Pending Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -3136,
        1296
      ],
      "notes": "PostgreSQL: Gets pending tasks ordered by priority. Matches WF01 dashboard query."
    },
    {
      "parameters": {
        "jsCode": "// Enhanced Task Categorization with Priority Logic\nconst tasks = $input.all();\nconst now = new Date();\nnow.setHours(0, 0, 0, 0);\n\nconst categorized = {\n  critical: [],\n  overdue: [],\n  today: [],\n  upcoming: []\n};\n\nconst byType = {};\nconst byProperty = {};\n\n// Critical task types that require immediate attention\nconst criticalTypes = ['calendar_sync', 'platform_block', 'guest_emergency', 'payment_issue'];\n\ntasks.forEach(item => {\n  const task = item.json;\n  const dueDate = task.due_date ? new Date(task.due_date) : null;\n  \n  if (dueDate) {\n    dueDate.setHours(0, 0, 0, 0);\n  }\n  \n  const taskType = task.task_type || 'other';\n  const priority = task.priority || 'medium';\n  const propertyName = task.property_name || 'Unknown Property';\n  \n  // Enhanced task object with computed fields\n  const enhancedTask = {\n    ...task,\n    daysOverdue: dueDate && dueDate < now ? Math.floor((now - dueDate) / (1000 * 60 * 60 * 24)) : 0,\n    priorityScore: priority === 'high' ? 3 : priority === 'medium' ? 2 : 1,\n    isCritical: criticalTypes.includes(taskType) || priority === 'high'\n  };\n  \n  // Categorize by urgency\n  if (criticalTypes.includes(taskType) || priority === 'high') {\n    categorized.critical.push(enhancedTask);\n  } else if (dueDate && dueDate < now) {\n    categorized.overdue.push(enhancedTask);\n  } else if (dueDate && dueDate.getTime() === now.getTime()) {\n    categorized.today.push(enhancedTask);\n  } else {\n    categorized.upcoming.push(enhancedTask);\n  }\n  \n  // Group by type\n  if (!byType[taskType]) {\n    byType[taskType] = [];\n  }\n  byType[taskType].push(enhancedTask);\n  \n  // Group by property\n  if (!byProperty[propertyName]) {\n    byProperty[propertyName] = [];\n  }\n  byProperty[propertyName].push(enhancedTask);\n});\n\n// Sort each category by priority and due date\nconst sortTasks = (a, b) => {\n  if (a.priorityScore !== b.priorityScore) {\n    return b.priorityScore - a.priorityScore;\n  }\n  const dateA = a.due_date ? new Date(a.due_date) : new Date('9999-12-31');\n  const dateB = b.due_date ? new Date(b.due_date) : new Date('9999-12-31');\n  return dateA - dateB;\n};\n\ncategorized.critical.sort(sortTasks);\ncategorized.overdue.sort(sortTasks);\ncategorized.today.sort(sortTasks);\ncategorized.upcoming.sort(sortTasks);\n\n// Calculate summary statistics\nconst summary = {\n  total: tasks.length,\n  critical: categorized.critical.length,\n  overdue: categorized.overdue.length,\n  today: categorized.today.length,\n  upcoming: categorized.upcoming.length,\n  byType: Object.entries(byType).map(([type, items]) => ({\n    type,\n    count: items.length\n  })),\n  byProperty: Object.entries(byProperty).map(([property, items]) => ({\n    property,\n    count: items.length\n  }))\n};\n\nreturn [{\n  json: {\n    categorized,\n    byType,\n    byProperty,\n    summary,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "46d1020f-d516-4f94-befe-0681d6e9f22e",
      "name": "Enhanced Task Categorization",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2912,
        1296
      ]
    },
    {
      "parameters": {
        "jsCode": "// Enhanced Contact Message Formatter with Dynamic Keyboard\nconst data = $input.first().json;\nconst tasks = data.categorized;\nconst summary = data.summary;\nconst config = $('Workflow Configuration').first().json;\n\n// Build message header\nlet message = `\u2705 *YOUR TASK QUEUE*\\n`;\nmessage += `\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n\\n`;\n\n// Add summary stats\nmessage += `\ud83d\udcca *Summary:* ${summary.total} total tasks\\n\\n`;\n\n// Critical tasks section\nif (tasks.critical.length > 0) {\n  message += `\ud83d\udd34 *CRITICAL (${tasks.critical.length}):*\\n`;\n  tasks.critical.forEach((t, idx) => {\n    const icon = t.task_type === 'calendar_sync' ? '\ud83d\udcc5' : \n                 t.task_type === 'platform_block' ? '\ud83d\udeab' : \n                 t.task_type === 'guest_emergency' ? '\ud83c\udd98' : '\u26a0\ufe0f';\n    message += `${icon} ${t.description}`;\n    if (t.property_name) message += ` - *${t.property_name}*`;\n    message += `\\n`;\n  });\n  message += `\\n`;\n}\n\n// Overdue tasks section\nif (tasks.overdue.length > 0) {\n  message += `\u23f0 *OVERDUE (${tasks.overdue.length}):*\\n`;\n  tasks.overdue.forEach(t => {\n    const dueDate = new Date(t.due_date);\n    const daysLate = t.daysOverdue || 0;\n    message += `\u2022 ${t.description}`;\n    if (t.property_name) message += ` - ${t.property_name}`;\n    message += ` (${daysLate}d late)\\n`;\n  });\n  message += `\\n`;\n}\n\n// Today's tasks section\nif (tasks.today.length > 0) {\n  message += `\ud83d\udcc5 *TODAY (${tasks.today.length}):*\\n`;\n  tasks.today.forEach(t => {\n    message += `\u2022 ${t.description}`;\n    if (t.property_name) message += ` - ${t.property_name}`;\n    message += `\\n`;\n  });\n  message += `\\n`;\n}\n\n// Upcoming tasks summary\nif (tasks.upcoming.length > 0) {\n  message += `\ud83d\udccb *Upcoming:* ${tasks.upcoming.length} tasks\\n\\n`;\n}\n\nmessage += `\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\\n`;\nmessage += `Use buttons below to manage tasks`;\n\n// Create inline keyboard for top 10 actionable tasks\nconst allTasks = [\n  ...tasks.critical,\n  ...tasks.overdue,\n  ...tasks.today\n].slice(0, 10);\n\nconst keyboard = {\n  inline_keyboard: []\n};\n\n// Add task action buttons (2 per row)\nallTasks.forEach((t, idx) => {\n  const taskLabel = t.description.substring(0, 25) + (t.description.length > 25 ? '...' : '');\n  const taskNum = idx + 1;\n  \n  keyboard.inline_keyboard.push(\n    [\n      {\n        text: `\u2713 Complete #${taskNum}`,\n        callback_data: `complete_${t.task_id}`\n      },\n      {\n        text: `\u23f0 Snooze #${taskNum}`,\n        callback_data: `snooze_${t.task_id}`\n      }\n    ],\n    [\n      {\n        text: `\ud83d\udc64 Delegate #${taskNum}`,\n        callback_data: `delegate_${t.task_id}`\n      },\n      {\n        text: `\u2139\ufe0f Details #${taskNum}`,\n        callback_data: `details_${t.task_id}`\n      }\n    ]\n  );\n});\n\n// Add utility buttons at the bottom\nkeyboard.inline_keyboard.push(\n  [\n    {text: '\ud83d\udd04 Refresh', callback_data: 'refresh_tasks'},\n    {text: '\ud83d\udcca Analytics', callback_data: 'view_analytics'}\n  ],\n  [\n    {text: '\ud83c\udfe1 Dashboard', callback_data: 'dashboard'},\n    {text: '\u2795 New Task', callback_data: 'create_task'}\n  ]\n);\n\nreturn [{\n  json: {\n    messageText: message,\n    replyMarkup: keyboard,\n    taskCount: summary.total,\n    topTasks: allTasks,\n    allCategories: tasks\n  }\n}];"
      },
