    {
      "parameters": {
        "jsCode": "// Enhanced Confirmation Message Builder\nconst data = $input.first().json;\nconst action = data.action;\nconst taskId = data.task_id;\nconst responseMsg = data.responseMessage;\n\nlet message = responseMsg;\nlet nextSteps = '';\n\nswitch(action) {\n  case 'complete':\n    nextSteps = 'Task has been marked complete and removed from your queue.';\n    break;\n  case 'snooze':\n    nextSteps = 'Task will reappear in your queue in 2 hours.';\n    break;\n  case 'delegate':\n    nextSteps = 'Manager has been notified and will handle this task.';\n    break;\n  default:\n    nextSteps = 'No further action required at this time.';\n}\n\nmessage += `\\n\\n\ud83d\udca1 *Next Steps:*\\n${nextSteps}`;\nmessage += `\\n\\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501`;\nmessage += `\\nTask ID: ${taskId}`;\n\nreturn [{\n  json: {\n    confirmationMessage: message,\n    contact_id: data.contact_id,\n    channel_type: data.channel_type,\n    action: action,\n    task_id: taskId\n  }\n}];"
      },
