    {
      "parameters": {
        "jsCode": "// Format detailed task information\nconst task = $input.first().json;\n\nconst detailMessage = `\n\ud83d\udccb *TASK DETAILS*\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n\ud83c\udd94 *ID:* ${task.task_id}\n\ud83d\udcdd *Description:* ${task.description}\n\ud83c\udfe0 *Property:* ${task.property_name || 'N/A'}\n\ud83d\udcc5 *Due Date:* ${task.due_date ? new Date(task.due_date).toLocaleString() : 'Not set'}\n\u26a1 *Priority:* ${task.priority || 'Medium'}\n\ud83d\udcca *Status:* ${task.status}\n\ud83c\udff7\ufe0f *Type:* ${task.task_type || 'General'}\n\n${task.notes ? `\ud83d\udccc *Notes:*\\n${task.notes}\\n\\n` : ''}\n${task.assigned_to ? `\ud83d\udc64 *Assigned To:* ${task.assigned_to}\\n` : ''}\n${task.created_date ? `\ud83d\udcc5 *Created:* ${new Date(task.created_date).toLocaleString()}\\n` : ''}\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n`;\n\nreturn [{\n  json: {\n    detailMessage,\n    task_id: task.task_id,\n    contact_id: $('Enhanced Action Parser').first().json.contact_id,\n    channel_type: $('Enhanced Action Parser').first().json.channel_type\n  }\n}];"
      },
