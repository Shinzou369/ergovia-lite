    {
      "parameters": {
        "jsCode": "// Format issue alert message for property owner\nconst items = $input.all();\nconst formattedItems = [];\n\nfor (const item of items) {\n  const propertyName = item.json.propertyName || 'Unknown Property';\n  const cleanerName = item.json.cleanerName || 'Unknown Cleaner';\n  const completionPercentage = item.json.completionPercentage || 0;\n  const photos = item.json.photos || [];\n  const issuesFound = item.json.issuesFound || item.json.cleanerFeedback || 'No specific issues reported';\n  \n  // Format the alert message\n  let alertMessage = `\ud83d\udea8 CLEANING QUALITY ALERT \ud83d\udea8\n\n`;\n  alertMessage += `Property: ${propertyName}\n`;\n  alertMessage += `Cleaner: ${cleanerName}\n`;\n  alertMessage += `Completion: ${completionPercentage}%\n\n`;\n  \n  if (completionPercentage < 100) {\n    alertMessage += `\u26a0\ufe0f Task not fully completed (${completionPercentage}%)\n\n`;\n  }\n  \n  alertMessage += `Issues Reported:\n${issuesFound}\n\n`;\n  \n  if (photos && photos.length > 0) {\n    alertMessage += `\ud83d\udcf8 Photos attached: ${photos.length}\n`;\n  }\n  \n  alertMessage += `\nPlease review and decide:\n`;\n  alertMessage += `1\ufe0f\u20e3 Approve and mark property as ready\n`;\n  alertMessage += `2\ufe0f\u20e3 Request re-clean`;\n  \n  formattedItems.push({\n    json: {\n      ...item.json,\n      alertMessage: alertMessage,\n      messageText: alertMessage\n    }\n  });\n}\n\nreturn formattedItems;"
      },
