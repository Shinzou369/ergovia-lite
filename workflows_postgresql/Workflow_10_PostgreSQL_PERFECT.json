        "jsCode": "// Format success notification message\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const propertyName = item.json.propertyName || 'Unknown Property';\n  const cleanerName = item.json.cleanerName || 'Unknown Cleaner';\n  const completionPercentage = item.json.completionPercentage || 0;\n  const photoLink = item.json.photoLink || item.json.formResponseUrl || 'No photos available';\n  \n  const message = `\u2705 Cleaning Completed Successfully!\n\n\ud83c\udfe0 Property: ${propertyName}\n\ud83d\udc64 Cleaner: ${cleanerName}\n\ud83d\udcca Completion: ${completionPercentage}%\n\n\ud83d\udcf8 View Photos: ${photoLink}\n\nThe property is ready for guests!`;\n  \n  results.push({\n    json: {\n      ...item.json,\n      successMessage: message\n    }\n  });\n}\n\nreturn results;"
      },
