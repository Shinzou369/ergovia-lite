      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a friendly property management assistant. Generate 2-3 warm follow-up questions for a cleaner who just completed a cleaning task. Return your response as JSON with a 'questions' array containing strings.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Property: {{ $('Get Property Configuration').item.json.property_name }}\nCleaner: {{ $('Lookup Cleaner Contact Info').item.json.cleaner_name }}\nIssues Found: {{ $('Extract Form Data and Calculate Completion').item.json.issues_found }}\nNotes: {{ $('Extract Form Data and Calculate Completion').item.json.notes }}\"\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" }\n}",
        "options": {}
      },
      "id": "73d2a3e7-9d0b-4b5a-a899-72108bd2c463",
      "name": "Generate Follow-up Questions via OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -5168,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract questions from OpenAI response and format into friendly message\nconst openAIResponse = $input.first().json;\n\n// Parse the OpenAI response to get questions array\nlet questions = [];\ntry {\n  // Check if response has choices array (standard OpenAI format)\n  if (openAIResponse.choices && openAIResponse.choices[0]) {\n    const content = openAIResponse.choices[0].message.content;\n    // Try to parse as JSON if it's a JSON string\n    try {\n      const parsed = JSON.parse(content);\n      questions = parsed.questions || parsed;\n    } catch {\n      // If not JSON, split by newlines and filter out empty lines\n      questions = content.split('\n').filter(q => q.trim().length > 0);\n    }\n  } else if (openAIResponse.questions) {\n    questions = openAIResponse.questions;\n  } else if (Array.isArray(openAIResponse)) {\n    questions = openAIResponse;\n  }\n} catch (error) {\n  console.log('Error parsing OpenAI response:', error);\n  questions = ['Was everything completed to your satisfaction?'];\n}\n\n// Format questions into numbered list\nconst numberedQuestions = questions\n  .map((q, index) => `${index + 1}. ${q.replace(/^\\d+\\.\\s*/, '').trim()}`)\n  .join('\n');\n\n// Create friendly message\nconst message = `Hi! Thank you for completing the cleaning task. \ud83e\uddf9\u2728\n\nTo help us ensure everything meets our quality standards, please answer these quick questions:\n\n${numberedQuestions}\n\nPlease reply with your answers. Thank you!`;\n\nreturn {\n  json: {\n    message: message,\n    questions: questions,\n    questionCount: questions.length\n  }\n};"
      },
