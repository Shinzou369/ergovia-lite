    {
      "parameters": {
        "jsCode": "// Extract form data from webhook body\nconst body = $input.item.json.body;\n\n// Define the 7 checklist items\nconst checklistItems = {\n  Dusted: body.Dusted === 'true' || body.Dusted === true || body.Dusted === 'on',\n  Vacuumed: body.Vacuumed === 'true' || body.Vacuumed === true || body.Vacuumed === 'on',\n  'Cleaned bathrooms': body['Cleaned bathrooms'] === 'true' || body['Cleaned bathrooms'] === true || body['Cleaned bathrooms'] === 'on',\n  'Changed linens': body['Changed linens'] === 'true' || body['Changed linens'] === true || body['Changed linens'] === 'on',\n  'Restocked toiletries': body['Restocked toiletries'] === 'true' || body['Restocked toiletries'] === true || body['Restocked toiletries'] === 'on',\n  'Trash out': body['Trash out'] === 'true' || body['Trash out'] === true || body['Trash out'] === 'on',\n  'Checked appliances': body['Checked appliances'] === 'true' || body['Checked appliances'] === true || body['Checked appliances'] === 'on'\n};\n\n// Count checked items\nconst checkedCount = Object.values(checklistItems).filter(item => item === true).length;\n\n// Calculate completion percentage\nconst totalItems = 7;\nconst completionPercentage = Math.round((checkedCount / totalItems) * 100);\n\n// Return structured data\nreturn [\n  {\n    json: {\n      task_id: body.task_id || body.taskId,\n      cleaner_name: body.cleaner_name || body.cleanerName,\n      completion_photos: body.completion_photos || body.completionPhotos || [],\n      checklist_items: checklistItems,\n      time_spent: body.time_spent || body.timeSpent,\n      issues_found: body.issues_found || body.issuesFound || '',\n      notes: body.notes || '',\n      completion_percentage: completionPercentage\n    }\n  }\n];"
      },
