    {
      "parameters": {
        "jsCode": "// Group items by property_id and supplier\nconst grouped = {};\n\n// Process all input items\nfor (const item of $input.all()) {\n  const propertyId = item.json.property_id;\n  const supplier = item.json.supplier;\n  \n  // Initialize property if it doesn't exist\n  if (!grouped[propertyId]) {\n    grouped[propertyId] = {};\n  }\n  \n  // Initialize supplier array if it doesn't exist\n  if (!grouped[propertyId][supplier]) {\n    grouped[propertyId][supplier] = [];\n  }\n  \n  // Add item to the appropriate group\n  grouped[propertyId][supplier].push(item.json);\n}\n\n// Return the grouped data\nreturn [{ json: { grouped } }];"
      },
      "id": "675cb1ed-aa28-4013-8151-3d214e90f5ac",
      "name": "Group Items by Supplier and Property",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        368
      ]
    },
