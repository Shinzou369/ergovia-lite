    {
      "parameters": {
        "jsCode": "// Prepare confirmation message for manager\nconst items = $input.all();\n\nif (items.length === 0) {\n  return [{\n    json: {\n      message: \"No orders were placed.\"\n    }\n  }];\n}\n\n// Extract order details from the input\nconst orderDetails = items.map(item => {\n  const data = item.json;\n  return {\n    supplier: data.supplier_name || data.supplier || 'Unknown Supplier',\n    items: data.items || [],\n    totalAmount: data.total_amount || data.totalAmount || 0,\n    expectedDelivery: data.expected_delivery || data.expectedDelivery || 'TBD',\n    poNumber: data.po_number || data.poNumber || 'N/A'\n  };\n});\n\n// Build the confirmation message\nlet message = \"\u2705 *Purchase Orders Placed Successfully*\n\n\";\n\norderDetails.forEach((order, index) => {\n  message += `\ud83d\udce6 *Order ${index + 1}*\n`;\n  message += `Supplier: ${order.supplier}\n`;\n  message += `PO Number: ${order.poNumber}\n`;\n  message += `Expected Delivery: ${order.expectedDelivery}\n`;\n  message += `Total Amount: $${order.totalAmount.toFixed(2)}\n`;\n  \n  if (order.items.length > 0) {\n    message += `Items:\n`;\n    order.items.forEach(item => {\n      message += `  \u2022 ${item.name || item.item_name}: ${item.quantity} units\n`;\n    });\n  }\n  \n  message += \"\n\";\n});\n\nmessage += \"\n\ud83d\udcca View full inventory status\";\n\nreturn [{\n  json: {\n    message: message,\n    orderCount: orderDetails.length,\n    orders: orderDetails,\n    platform: items[0].json.platform || items[0].json.contact_platform || 'telegram'\n  }\n}];"
      },
