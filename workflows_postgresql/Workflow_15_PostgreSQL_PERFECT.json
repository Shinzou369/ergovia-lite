      "id": "3c7953dd-9856-44e1-8f35-846ba370a398",
      "name": "Get Property Configuration",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        432,
        368
      ],
      "notes": "PostgreSQL: Gets property config for manager notifications."
    },
    {
      "parameters": {
        "jsCode": "// Create purchase order proposals with property info and supplier groupings\nconst items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\n// Get property configuration from the first item\nconst propertyConfig = items[0].json;\nconst propertyName = propertyConfig.property_name;\nconst inventoryManagerContact = propertyConfig.inventory_manager_contact;\nconst preferredPlatform = propertyConfig.preferred_platform;\n\n// Get the grouped items data\nconst groupedItems = propertyConfig.items || [];\n\n// Create purchase order proposals grouped by supplier\nconst proposals = [];\n\nfor (const group of groupedItems) {\n  const proposal = {\n    property_name: propertyName,\n    inventory_manager_contact: inventoryManagerContact,\n    preferred_platform: preferredPlatform,\n    supplier_name: group.supplier_name,\n    supplier_id: group.supplier_id,\n    items: group.items.map(item => ({\n      item_name: item.item_name,\n      item_id: item.item_id,\n      current_quantity: item.current_quantity,\n      reorder_point: item.reorder_point,\n      reorder_quantity: item.reorder_quantity,\n      unit_cost: item.unit_cost,\n      total_cost: (item.reorder_quantity * item.unit_cost).toFixed(2)\n    })),\n    total_order_cost: group.items.reduce((sum, item) => \n      sum + (item.reorder_quantity * item.unit_cost), 0\n    ).toFixed(2),\n    item_count: group.items.length\n  };\n  \n  proposals.push({ json: proposal });\n}\n\nreturn proposals;"
      },
