    {
      "parameters": {
        "jsCode": "// Process supplies_used array from webhook body\nconst webhookData = $input.first().json;\nconst suppliesUsed = webhookData.body?.supplies_used || webhookData.supplies_used || [];\n\n// Create an item for each supply with required fields\nconst items = suppliesUsed.map(supply => ({\n  json: {\n    item_name: supply.item_name,\n    quantity_used: supply.quantity_used,\n    property_id: supply.property_id\n  }\n}));\n\nreturn items;"
      },
      "id": "f4ffc437-10c6-4603-8939-0a57b9df33c2",
      "name": "Process Supplies Used",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1808,
        176
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM inventory \nWHERE property_id = $1\nORDER BY category, item_name",
        "additionalFields": {
          "queryParameters": "={{ { \"parameters\": [$json.property_id] } }}"
        },
        "options": {}
      },
      "id": "f6356f20-5fdd-4181-9d47-71c9b086d7a6",
      "name": "Get All Inventory Items",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -2032,
        368
      ],
      "notes": "PostgreSQL: Gets all inventory items for a property."
    },
    {
      "parameters": {
        "jsCode": "// Filter items where current quantity is at or below reorder point\nconst itemsBelowReorderPoint = [];\n\nfor (const item of $input.all()) {\n  const currentQty = item.json.current_qty || 0;\n  const reorderPoint = item.json.reorder_point || 0;\n  \n  if (currentQty <= reorderPoint) {\n    itemsBelowReorderPoint.push(item);\n  }\n}\n\nreturn itemsBelowReorderPoint;"
      },
      "id": "3072ee05-0e3d-4478-ba63-2a73eacbd2c0",
      "name": "Filter Items Below Reorder Point",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1808,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calculate predicted usage based on guest nights from booking\nconst bookingData = $input.first().json;\nconst configData = $('Workflow Configuration').first().json;\n\n// Get guest nights from booking\nconst guestNights = bookingData.guest_nights || 0;\nconst propertyId = bookingData.property_id;\n\n// Get usage rates from configuration\nconst toiletPaperRate = configData.toilet_paper_rate || 0.5;\nconst paperTowelsRate = configData.paper_towels_rate || 0.3;\nconst trashBagsRate = configData.trash_bags_rate || 0.2;\n\n// Calculate predicted usage for each item\nconst items = [\n  {\n    item_name: 'Toilet Paper',\n    predicted_usage: Math.ceil(guestNights * toiletPaperRate),\n    property_id: propertyId\n  },\n  {\n    item_name: 'Paper Towels',\n    predicted_usage: Math.ceil(guestNights * paperTowelsRate),\n    property_id: propertyId\n  },\n  {\n    item_name: 'Trash Bags',\n    predicted_usage: Math.ceil(guestNights * trashBagsRate),\n    property_id: propertyId\n  }\n];\n\nreturn items.map(item => ({ json: item }));"
      },
      "id": "67fbd389-bb0c-4f5a-be0f-c8223831f3c1",
      "name": "Calculate Predicted Usage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1808,
        560
