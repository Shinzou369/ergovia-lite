    {
      "parameters": {
        "fromEmail": "<__PLACEHOLDER_VALUE__Your email address__>",
        "toEmail": "={{ $json.supplier_email }}",
        "subject": "New Purchase Order - Supplies Needed",
        "html": "=<h2>New Purchase Order</h2>\n\n<p>Dear Supplier,</p>\n\n<p>We would like to place an order for the following items:</p>\n\n<h3>Order Details:</h3>\n<ul>\n  <li><strong>Purchase Order ID:</strong> {{ $json.po_id }}</li>\n  <li><strong>Property:</strong> {{ $json.property_name }}</li>\n  <li><strong>Order Date:</strong> {{ $json.order_date }}</li>\n</ul>\n\n<h3>Items Requested:</h3>\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">\n  <thead>\n    <tr style=\"background-color: #f2f2f2;\">\n      <th>Item Name</th>\n      <th>Quantity</th>\n      <th>Unit</th>\n    </tr>\n  </thead>\n  <tbody>\n    {{ $json.items.map(item => `\n    <tr>\n      <td>${item.name}</td>\n      <td>${item.quantity}</td>\n      <td>${item.unit}</td>\n    </tr>\n    `).join('') }}\n  </tbody>\n</table>\n\n<h3>Delivery Instructions:</h3>\n<p>{{ $json.delivery_instructions || 'Please deliver to the property address on file.' }}</p>\n\n<p>Please confirm receipt of this order and provide an estimated delivery date.</p>\n\n<p>Thank you for your service.</p>\n\n<p>Best regards,<br>\nProperty Management Team</p>",
        "options": {}
