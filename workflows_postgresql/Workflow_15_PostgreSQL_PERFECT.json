      "id": "19599eeb-e3c1-4794-b8b2-3ebc5cc288ab",
      "name": "Collect Items for Reorder",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        -240,
        368
      ]
