      "id": "6eb7f006-6e29-4c8d-8776-4ed98d842ab6",
      "name": "Lookup Item in Inventory",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -1136,
        304
      ],
      "notes": "PostgreSQL: Looks up specific inventory item for property."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get the current item data\nconst item = $input.item.json;\n\n// Calculate new quantity\n// Subtract quantity_used if present, otherwise subtract predicted_usage\nconst quantityToSubtract = item.quantity_used || item.predicted_usage || 0;\nconst new_qty = item.current_qty - quantityToSubtract;\n\n// Check if below reorder point\nconst below_threshold = new_qty < item.reorder_point;\n\n// Return the item with new fields\nreturn {\n  ...item,\n  new_qty: new_qty,\n  below_threshold: below_threshold\n};"
      },
      "id": "fb089416-3c34-4811-b7f6-4c6c087290f5",
      "name": "Calculate New Quantity and Check Threshold",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -912,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE inventory \nSET current_qty = $2,\n    last_usage_date = CURRENT_DATE,\n    status = CASE \n        WHEN $2 <= min_qty THEN 'low_stock'\n        WHEN $2 = 0 THEN 'out_of_stock'\n        ELSE 'in_stock'\n    END,\n    updated_at = CURRENT_TIMESTAMP\nWHERE item_name = $1",
        "additionalFields": {
          "queryParameters": "={{ { \"parameters\": [$json.item_name, $json.new_qty] } }}"
        },
        "options": {}
      },
      "id": "09223037-3815-4a54-91c0-9ab19d8e293b",
      "name": "Update Inventory Quantity",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -688,
        304
      ],
      "notes": "PostgreSQL: Updates inventory quantity and auto-calculates status (in_stock/low_stock/out_of_stock)."
    },
