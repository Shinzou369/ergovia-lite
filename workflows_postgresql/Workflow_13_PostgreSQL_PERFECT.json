    {
      "parameters": {
        "jsCode": "// Normalize data from different sources\nconst items = $input.all();\nconst normalizedItems = [];\n\nfor (const item of items) {\n  const data = item.json;\n  let normalized = {\n    property_name: '',\n    issue_description: '',\n    reported_by: '',\n    channel_type: '',\n    photos: []\n  };\n\n  // Detect source and normalize accordingly\n  \n  // Google Forms\n  if (data.body && data.body['Property Name']) {\n    normalized.property_name = data.body['Property Name'] || '';\n    normalized.issue_description = data.body['Issue Description'] || data.body['Describe the issue'] || '';\n    normalized.reported_by = data.body['Your Name'] || data.body['Email'] || '';\n    normalized.channel_type = 'google_forms';\n    normalized.photos = data.body['Photos'] || [];\n  }\n  \n  // Maintenance Data Webhook (JSON)\n  else if (data.body && data.body.property_name) {\n    normalized.property_name = data.body.property_name || '';\n    normalized.issue_description = data.body.issue_description || data.body.description || '';\n    normalized.reported_by = data.body.reported_by || data.body.reporter || '';\n    normalized.channel_type = 'webhook';\n    normalized.photos = data.body.photos || [];\n  }\n  \n  // Twilio SMS\n  else if (data.From && data.Body) {\n    const messageBody = data.Body.toLowerCase();\n    if (messageBody.includes('maintenance')) {\n      normalized.property_name = data.property || '';\n      normalized.issue_description = data.Body || '';\n      normalized.reported_by = data.From || '';\n      normalized.channel_type = 'sms';\n      normalized.photos = data.MediaUrl0 ? [data.MediaUrl0] : [];\n    }\n  }\n  \n  // WhatsApp\n  else if (data.from && data.message) {\n    const messageBody = (data.message.text || '').toLowerCase();\n    if (messageBody.includes('maintenance')) {\n      normalized.property_name = data.property || '';\n      normalized.issue_description = data.message.text || '';\n      normalized.reported_by = data.from || '';\n      normalized.channel_type = 'whatsapp';\n      normalized.photos = data.message.media ? [data.message.media] : [];\n    }\n  }\n  \n  // Telegram\n  else if (data.message && data.message.text) {\n    const messageBody = data.message.text.toLowerCase();\n    if (messageBody.includes('maintenance')) {\n      normalized.property_name = data.property || '';\n      normalized.issue_description = data.message.text || '';\n      normalized.reported_by = data.message.from.username || data.message.from.first_name || '';\n      normalized.channel_type = 'telegram';\n      normalized.photos = data.message.photo ? data.message.photo.map(p => p.file_id) : [];\n    }\n  }\n  \n  // Only add if we have at least an issue description\n  if (normalized.issue_description) {\n    normalizedItems.push({ json: normalized });\n  }\n}\n\nreturn normalizedItems;"
      },
      "id": "ca729bc9-e367-4265-a8d7-659a40c86f9d",
