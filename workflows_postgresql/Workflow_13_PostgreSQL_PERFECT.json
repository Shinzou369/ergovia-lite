    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a maintenance issue analyzer. Analyze the maintenance issue and return a JSON object with the following fields: category (plumbing, electrical, appliance, hvac, structural, cosmetic, pest, outdoor, security), urgency (emergency, high, medium, low), vendor_type (handyman, plumber, electrician, hvac_tech, appliance_repair, contractor, pest_control, locksmith), guest_impact (yes or no), and reasoning (brief explanation of your analysis).\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.issue_description }}\"\n    }\n  ],\n  \"response_format\": {\n    \"type\": \"json_object\"\n  }\n}",
        "options": {}
      },
      "id": "3568b6b3-27f9-47c2-b877-aa93a814c63c",
      "name": "OpenAI Issue Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -4720,
        848
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the OpenAI response and extract the AI analysis\nconst openAIResponse = $input.first().json;\nconst aiContent = openAIResponse.choices[0].message.content;\n\n// Extract JSON from the AI response (it may be wrapped in markdown code blocks)\nlet aiAnalysis;\ntry {\n  // Try to find JSON in markdown code blocks\n  const jsonMatch = aiContent.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\n  if (jsonMatch) {\n    aiAnalysis = JSON.parse(jsonMatch[1].trim());\n  } else {\n    // Try to parse the entire content as JSON\n    aiAnalysis = JSON.parse(aiContent);\n  }\n} catch (error) {\n  // If parsing fails, try to extract JSON object directly\n  const jsonObjectMatch = aiContent.match(/\\{[\\s\\S]*\\}/);\n  if (jsonObjectMatch) {\n    aiAnalysis = JSON.parse(jsonObjectMatch[0]);\n  } else {\n    throw new Error('Failed to parse AI response: ' + error.message);\n  }\n}\n\n// Get the original normalized data from the Normalize Data node\nconst normalizedData = $('Normalize Data').first().json;\n\n// Merge the AI analysis with the original normalized data\nconst mergedData = {\n  ...normalizedData,\n  category: aiAnalysis.category,\n  urgency: aiAnalysis.urgency,\n  vendor_type: aiAnalysis.vendor_type,\n  guest_impact: aiAnalysis.guest_impact,\n  reasoning: aiAnalysis.reasoning\n};\n\nreturn [mergedData];"
      },
      "id": "088bc0eb-dd1e-4a16-8486-181174bed4d8",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
