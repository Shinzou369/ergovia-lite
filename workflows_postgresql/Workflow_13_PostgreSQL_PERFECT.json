    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM vendors \nWHERE category = $1\n  AND status = 'active'\n  AND current_jobs < max_concurrent_jobs\nORDER BY average_rating DESC, current_jobs ASC\nLIMIT 5",
        "additionalFields": {
          "queryParameters": "={{ { \"parameters\": [$json.vendor_type] } }}"
        },
        "options": {}
      },
      "id": "8aaf8f99-385d-4d07-991b-0caa9a857ad8",
      "name": "Query Vendors",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -3824,
        848
      ],
      "notes": "PostgreSQL: Finds available vendors for category, ordered by rating and workload."
    },
    {
      "parameters": {
        "jsCode": "// Get property configuration and vendors data\nconst propertyConfig = $input.first().json;\nconst vendors = $('Query Vendors').all();\n\n// Get parsed AI data to determine vendor type and urgency\nconst parsedData = $('Parse AI Response').first().json;\nconst vendorType = parsedData.vendor_type || parsedData.category;\nconst urgency = parsedData.urgency;\n\n// Check if property configuration has a designated vendor for this vendor_type\nconst designatedVendorField = `${vendorType}_vendor_contact`;\nconst designatedVendor = propertyConfig[designatedVendorField];\n\nlet selectedVendor;\n\nif (designatedVendor) {\n  // Use designated vendor from property configuration\n  const designatedVendorData = vendors.find(v => \n    v.json.contact_phone === designatedVendor || \n    v.json.contact_name === designatedVendor ||\n    v.json.vendor_name === designatedVendor\n  );\n  \n  if (designatedVendorData) {\n    selectedVendor = {\n      ...designatedVendorData.json,\n      score: 100,\n      selection_reason: 'Designated vendor for property'\n    };\n  }\n}\n\nif (!selectedVendor) {\n  // Score all vendors\n  const scoredVendors = vendors.map(vendor => {\n    const v = vendor.json;\n    const rating = parseFloat(v.rating) || 0;\n    const costLevel = (v.cost_level || '').toLowerCase();\n    const currentJobs = parseInt(v.current_jobs) || 0;\n    \n    // Calculate score: rating * 10 + (urgency != 'emergency' && cost_level == 'low' ? 5 : 0) - (current_jobs * 3)\n    let score = rating * 10;\n    \n    if (urgency !== 'emergency' && costLevel === 'low') {\n      score += 5;\n    }\n    \n    score -= (currentJobs * 3);\n    \n    return {\n      ...v,\n      score: score,\n      selection_reason: 'Highest score based on rating, cost, and availability'\n    };\n  });\n  \n  // Sort by score descending and select top vendor\n  scoredVendors.sort((a, b) => b.score - a.score);\n  selectedVendor = scoredVendors[0];\n}\n\nreturn [{ json: selectedVendor }];"
      },
