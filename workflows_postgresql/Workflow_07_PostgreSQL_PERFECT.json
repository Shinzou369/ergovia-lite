    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse booking confirmation from multiple sources\\n// Handles Telegram, WhatsApp, and webhook inputs\\n\\nconst item = $input.item.json;\\nlet booking_id = null;\\nlet contact_id = null;\\nlet platform = null;\\nlet action = null;\\n\\n// Check if this is from Telegram\\nif (item.message && item.message.chat && item.message.chat.type) {\\n  platform = 'telegram';\\n  \\n  // Extract contact_id from Telegram user\\n  contact_id = item.message.from?.id?.toString() || null;\\n  \\n  // Parse message text for PAID or CONFIRM pattern\\n  const messageText = item.message.text || '';\\n  const paidMatch = messageText.match(/PAID\\\\s+([A-Za-z0-9_-]+)/i);\\n  const confirmMatch = messageText.match(/CONFIRM\\\\s+([A-Za-z0-9_-]+)/i);\\n  \\n  if (paidMatch) {\\n    booking_id = paidMatch[1];\\n    action = 'paid';\\n  } else if (confirmMatch) {\\n    booking_id = confirmMatch[1];\\n    action = 'confirm';\\n  }\\n}\\n// Check if this is from WhatsApp\\nelse if (item.from || item.phone || (item.message && item.message.from && typeof item.message.from === 'string')) {\\n  platform = 'whatsapp';\\n  \\n  // Extract contact_id from WhatsApp (phone number)\\n  contact_id = item.message?.from || item.from || item.phone || null;\\n  \\n  // Parse message text for PAID or CONFIRM pattern\\n  const messageText = item.message?.text || item.text || item.body || '';\\n  const paidMatch = messageText.match(/PAID\\\\s+([A-Za-z0-9_-]+)/i);\\n  const confirmMatch = messageText.match(/CONFIRM\\\\s+([A-Za-z0-9_-]+)/i);\\n  \\n  if (paidMatch) {\\n    booking_id = paidMatch[1];\\n    action = 'paid';\\n  } else if (confirmMatch) {\\n    booking_id = confirmMatch[1];\\n    action = 'confirm';\\n  }\\n}\\n// Check if this is from webhook\\nelse if (item.body || item.booking_id || item.bookingId) {\\n  platform = 'webhook';\\n  \\n  // Extract from webhook payload\\n  const body = item.body || item;\\n  booking_id = body.booking_id || body.bookingId || item.booking_id || item.bookingId || null;\\n  contact_id = body.contact_id || body.contactId || item.contact_id || item.contactId || null;\\n  action = body.action || item.action || 'confirm';\\n}\\n\\n// Return parsed data\\nreturn {\\n  booking_id: booking_id,\\n  contact_id: contact_id,\\n  platform: platform,\\n  action: action,\\n  original_data: item\\n};"
      },
