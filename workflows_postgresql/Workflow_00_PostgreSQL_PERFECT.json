      "id": "d198c72a-1adb-47cd-a197-9218f5c4f824",
      "name": "Check Active Deal",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        336,
        464
      ],
      "notes": "PostgreSQL: Finds any active deal for this client. Checks multiple status values with IN clause for performance.",
      "credentials": {
        "postgres": {
          "id": "{{ POSTGRES_CREDENTIAL_ID }}",
          "name": "PostgreSQL Database"
        }
