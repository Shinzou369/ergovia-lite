    {
      "parameters": {
        "jsCode": "// Enhanced sender identifier extraction for all message channels\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  let senderId = '';\n  let senderPhone = null;\n  let messageText = '';\n  let channelType = '';\n  \n  // TELEGRAM DETECTION\n  if (data.message && data.message.from) {\n    channelType = 'telegram';\n    senderId = data.message.from.id ? data.message.from.id.toString() : '';\n    senderPhone = data.message.from.phone_number || null;\n    messageText = data.message.text || '';\n  } \n  // TWILIO SMS DETECTION\n  else if (data.Body && data.From) {\n    channelType = 'sms';\n    senderPhone = data.From;\n    senderId = senderPhone;\n    messageText = data.Body;\n  } \n  // WHATSAPP DETECTION (via WhatsApp Business API)\n  else if (data.from && data.text && data.text.body) {\n    channelType = 'whatsapp';\n    senderPhone = data.from;\n    senderId = senderPhone;\n    messageText = data.text.body;\n  }\n  // FALLBACK: WhatsApp alternative structure\n  else if (data.message && data.message.chat && data.message.from) {\n    channelType = 'whatsapp';\n    senderPhone = data.message.from;\n    senderId = senderPhone;\n    messageText = data.message.text || '';\n  }\n  \n  results.push({\n    json: {\n      sender_id: senderId,\n      sender_phone: senderPhone,\n      message_text: messageText,\n      channel_type: channelType,\n      timestamp: new Date().toISOString(),\n      original_data: data\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "a0413a89-7c1b-4889-9815-3a85e6599b32",
      "name": "Extract Sender Identifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check for owner commands (messages starting with '/')\nconst items = $input.all();\n\nconst ownerCommands = [];\nconst regularMessages = [];\n\nfor (const item of items) {\n  const messageText = item.json.message_text || '';\n  const trimmedText = messageText.trim();\n  \n  if (trimmedText.startsWith('/')) {\n    // This is an owner command\n    ownerCommands.push({\n      json: {\n        ...item.json,\n        is_owner_command: true,\n        command: trimmedText\n      }\n    });\n  } else {\n    // This is a regular message\n    regularMessages.push({\n      json: {\n        ...item.json,\n        is_owner_command: false,\n        command: null\n      }\n    });\n  }\n}\n\n// Return items to different output indexes\n// Output 0: Owner commands\n// Output 1: Regular messages\nreturn [ownerCommands, regularMessages];"
      },
