    {
      "parameters": {
        "jsCode": "// Determine routing based on booking/deal status\nconst currentItem = $input.first().json;\nconst bookingResults = $('Check Active Booking').all();\nconst dealResults = $('Check Active Deal').all();\n\nconst hasActiveBooking = bookingResults.length > 0;\nconst hasActiveDeal = dealResults.length > 0;\n\nlet routeTo, routingReason, associatedId;\n\nif (hasActiveBooking) {\n  const booking = bookingResults[0].json;\n  \n  // Verify booking is currently active (check-in to check-out period)\n  const now = new Date();\n  const checkIn = new Date(booking.check_in_date);\n  const checkOut = new Date(booking.check_out_date);\n  \n  if (now >= checkIn && now <= checkOut) {\n    routeTo = 'active_booking_handler';\n    routingReason = 'Currently staying guest';\n    associatedId = booking.booking_id;\n  } else {\n    // Booking exists but guest not currently staying\n    routeTo = 'inquiry_handler';\n    routingReason = 'Past/future guest - treated as new inquiry';\n    associatedId = null;\n  }\n} else if (hasActiveDeal) {\n  const deal = dealResults[0].json;\n  routeTo = 'ai_conversation_manager';\n  routingReason = 'Active pre-booking deal';\n  associatedId = deal.deal_id;\n} else {\n  routeTo = 'inquiry_handler';\n  routingReason = 'New inquiry';\n  associatedId = null;\n}\n\nreturn [{\n  json: {\n    ...currentItem,\n    route_to: routeTo,\n    routing_reason: routingReason,\n    associated_id: associatedId\n  }\n}];"
      },
