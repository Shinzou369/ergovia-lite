    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM deals \nWHERE client_phone = $1 \n  AND status IN ('negotiation', 'pending_conflict', 'needs_owner_decision', \n                 'pending_payment_confirmation', 'ai_conversation')\nORDER BY created_at DESC\nLIMIT 1",
        "additionalFields": {
