    {
      "parameters": {
        "jsCode": "const bookingData = $input.first().json;\\nconst checkIn = new Date(bookingData.check_in_date);\\nconst checkOut = new Date(bookingData.check_out_date);\\n\\n// Helper function to set time\\nfunction setTime(date, hours, minutes = 0) {\\n  const newDate = new Date(date);\\n  newDate.setHours(hours, minutes, 0, 0);\\n  return newDate.toISOString();\\n}\\n\\n// Helper function to add/subtract days\\nfunction addDays(date, days) {\\n  const newDate = new Date(date);\\n  newDate.setDate(newDate.getDate() + days);\\n  return newDate;\\n}\\n\\nconst schedules = {\\n  welcome_payment_confirmed: new Date().toISOString(),\\n  pre_arrival: setTime(addDays(checkIn, -3), 10),\\n  checkin_instructions: setTime(addDays(checkIn, -1), 10),\\n  checkin_day_reminder: setTime(checkIn, 9),\\n  midstay_checkin: setTime(addDays(checkIn, 1), 11),\\n  checkout_reminder: setTime(addDays(checkOut, -1), 18),\\n  checkout_day_instructions: setTime(checkOut, 8),\\n  post_stay_thanks: setTime(addDays(checkOut, 1), 15),\\n  review_request: setTime(addDays(checkOut, 2), 10)\\n};\\n\\nreturn [{\\n  json: {\\n    ...bookingData,\\n    schedules\\n  }\\n}];"
      },
