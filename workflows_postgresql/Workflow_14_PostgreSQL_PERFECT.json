    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse vendor updates from different sources\nconst item = $input.item.json;\n\n// Initialize result object\nlet result = {\n  ticket_id: null,\n  status: null,\n  photos: [],\n  labor_hours: null,\n  notes: null,\n  source: null\n};\n\n// Determine source type\nif (item.body && typeof item.body === 'object') {\n  // Webhook form data\n  result.source = 'webhook';\n  result.ticket_id = item.body.ticket_id || null;\n  result.status = item.body.status || null;\n  result.photos = item.body.photos || [];\n  result.labor_hours = item.body.labor_hours || null;\n  result.notes = item.body.notes || null;\n} else {\n  // SMS/WhatsApp/Telegram message\n  let messageText = '';\n  \n  // Determine message source and extract text\n  if (item.message && item.message.text) {\n    // Telegram\n    result.source = 'telegram';\n    messageText = item.message.text;\n  } else if (item.Body) {\n    // Twilio SMS\n    result.source = 'sms';\n    messageText = item.Body;\n  } else if (item.text) {\n    // WhatsApp\n    result.source = 'whatsapp';\n    messageText = item.text;\n  }\n  \n  // Extract ticket number using regex\n  const ticketPattern = /#(\\d+)|ticket\\s*(\\d+)/i;\n  const ticketMatch = messageText.match(ticketPattern);\n  if (ticketMatch) {\n    result.ticket_id = ticketMatch[1] || ticketMatch[2];\n  }\n  \n  // Determine status from keywords\n  const lowerText = messageText.toLowerCase();\n  if (lowerText.includes('arrived')) {\n    result.status = 'arrived';\n  } else if (lowerText.includes('started') || lowerText.includes('in progress') || lowerText.includes('in_progress')) {\n    result.status = 'in_progress';\n  } else if (lowerText.includes('done') || lowerText.includes('completed')) {\n    result.status = 'completed';\n  }\n  \n  // Store the full message as notes\n  result.notes = messageText;\n}\n\nreturn result;"
      },
