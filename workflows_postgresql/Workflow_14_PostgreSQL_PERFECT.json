    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse callback data from Telegram or WhatsApp button presses\nconst inputData = $input.item.json;\n\nlet action = '';\nlet ticket_id = '';\nlet contact_name = '';\nlet platform = '';\n\n// Check if this is a Telegram callback\nif (inputData.callback_query) {\n  platform = 'telegram';\n  const callbackData = inputData.callback_query.data || '';\n  \n  // Parse callback data format: action:ticket_id\n  const parts = callbackData.split(':');\n  action = parts[0] || '';\n  ticket_id = parts[1] || '';\n  \n  // Get contact name from callback query\n  const user = inputData.callback_query.from || {};\n  contact_name = user.first_name || user.username || 'Unknown';\n  if (user.last_name) {\n    contact_name += ' ' + user.last_name;\n  }\n}\n// Check if this is a WhatsApp callback\nelse if (inputData.entry && inputData.entry[0]?.changes) {\n  platform = 'whatsapp';\n  const changes = inputData.entry[0].changes[0] || {};\n  const value = changes.value || {};\n  const messages = value.messages || [];\n  \n  if (messages.length > 0) {\n    const message = messages[0];\n    \n    // Check for interactive button response\n    if (message.interactive && message.interactive.button_reply) {\n      const buttonReply = message.interactive.button_reply.id || '';\n      \n      // Parse button reply format: action:ticket_id\n      const parts = buttonReply.split(':');\n      action = parts[0] || '';\n      ticket_id = parts[1] || '';\n    }\n    \n    // Get contact name\n    const contacts = value.contacts || [];\n    if (contacts.length > 0) {\n      contact_name = contacts[0].profile?.name || contacts[0].wa_id || 'Unknown';\n    }\n  }\n}\n\n// Return standardized object\nreturn {\n  action: action,\n  ticket_id: ticket_id,\n  contact_name: contact_name,\n  platform: platform\n};"
      },
