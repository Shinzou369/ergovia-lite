        "jsCode": "const inputData = $input.all()[0].json;\n\n// Validate required fields\nif (!inputData.to || !inputData.subject) {\n  return [[], [{ json: { success: false, error: 'Missing required fields: to and subject are required' } }]];\n}\n\n// Note: channel_type parameter accepted but ignored (email only)\n// This service is for automated emails only, not guest communications\n\nreturn [[{ json: inputData }], []];"
