      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n\t\"type\": \"object\",\n\t\"properties\": {\n\t\t\"control_signal\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Control signal for routing: CREATE_MAINTENANCE, REQUEST_SUPPLIES, CHECK_EXTENSION, LATE_CHECKOUT, EARLY_CHECKOUT, MID_STAY_CLEANING, ESCALATE_TO_CONTACT, or NONE\"\n\t\t},\n\t\t\"response_text\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"The response message to send to the guest\"\n\t\t},\n\t\t\"metadata\": {\n\t\t\t\"type\": \"string\",\n\t\t\t\"description\": \"Additional metadata for the control signal (e.g., category:description for maintenance, items for supplies)\"\n\t\t}\n\t}\n}"
      },
