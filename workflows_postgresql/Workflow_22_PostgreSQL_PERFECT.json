        "query": "SELECT \n    property_id,\n    property_name,\n    property_type,\n    max_guests,\n    base_price\nFROM property_configurations \nWHERE property_status = 'active'\n  AND property_id != $1\nORDER BY base_price ASC\nLIMIT 5",
