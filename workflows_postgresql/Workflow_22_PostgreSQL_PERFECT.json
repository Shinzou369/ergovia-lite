      "id": "e0138dd2-7b41-4272-879c-970997664608",
      "name": "Get Cleaners Workload",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        48,
        1824
      ],
      "notes": "PostgreSQL: Shows available cleaners sorted by workload."
    },
    {
      "parameters": {
        "jsCode": "const cleaners = $input.all();\nlet bestCleaner = cleaners[0];\nlet lowestWorkload = parseInt(cleaners[0].json.current_workload || 0);\n\nfor (let i = 1; i < cleaners.length; i++) {\n  const workload = parseInt(cleaners[i].json.current_workload || 0);\n  if (workload < lowestWorkload) {\n    lowestWorkload = workload;\n    bestCleaner = cleaners[i];\n  }\n}\n\nreturn {\n  json: {\n    ...bestCleaner.json,\n    recommended: true,\n    previous_data: $('Parse AI Response').item.json\n  }\n};"
      },
