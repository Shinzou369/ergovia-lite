        "query": "SELECT \n    cleaner_id,\n    cleaner_name,\n    current_jobs,\n    max_jobs_per_day,\n    status\nFROM cleaners \nWHERE status = 'active'\nORDER BY current_jobs ASC\nLIMIT 10",
        "options": {}
