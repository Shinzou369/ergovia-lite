        "jsCode": "const parseData = $('Parse AI Response').item.json;\nconst workflowConfig = $('Workflow Configuration').item.json;\nconst bookingData = $('Get Booking Data').item.json;\n\nlet conversationHistory = [];\nif (bookingData.conversation_history && bookingData.conversation_history !== '') {\n  try {\n    conversationHistory = JSON.parse(bookingData.conversation_history);\n  } catch (e) {\n    conversationHistory = [];\n  }\n}\n\nconversationHistory.push({\n  role: 'user',\n  content: workflowConfig.guest_message,\n  timestamp: new Date().toISOString()\n});\n\nconversationHistory.push({\n  role: 'assistant',\n  content: $input.item.json.response_text || parseData.response_text,\n  control_signal: parseData.control_signal,\n  timestamp: new Date().toISOString()\n});\n\nreturn {\n  json: {\n    booking_id: workflowConfig.booking_id,\n    conversation_history: JSON.stringify(conversationHistory)\n  }\n};"
