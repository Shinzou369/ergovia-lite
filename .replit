entrypoint="ergovia-lite/server.js"
hidden=[".config"]
modules = ["nodejs-20", "web"]
run = "cd ergovia-lite && npm start"

[nix]
channel = "stable-23_11"
packages = ["nodejs-20_x", "python3", "gcc", "gnumake"]

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "cd ergovia-lite && npm start"]
build = ["sh", "-c", "cd ergovia-lite && npm install"]

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "run"

[[workflows.workflow]]
name = "Ergovia Lite"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ergovia-lite && npm start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true
